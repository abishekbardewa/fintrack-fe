		"next-themes": "^0.4.6",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-chartjs-2": "^5.3.0",
		"react-dom": "^19.2.8",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.18.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
