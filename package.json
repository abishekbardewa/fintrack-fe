	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10.0.0"
	},
	"packageManager": "npm@10.9.2",
	"keywords": [
		"finance",
		"expense-tracker",
		"budgeting",
		"react",
		"typescript"
	],
	"scripts": {
